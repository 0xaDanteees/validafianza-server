{
    "swagger": "2.0",
    "info": {
        "description": "API para validación de pólizas de fianza de afianzadoras mexicanas.",
        "title": "Validafianza API",
        "contact": {
            "name": "Validafianza"
        },
        "license": {
            "name": "Private"
        },
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/api/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Terminates the authenticated user's session",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Logout",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the authenticated user's profile information",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/register-or-login": {
            "post": {
                "description": "Sends a one-time passcode to the user's email. Creates user if doesn't exist.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register or login with email",
                "parameters": [
                    {
                        "description": "User email and optional info",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.RegisterLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/verify": {
            "post": {
                "description": "Validates the one-time passcode and returns authentication token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Verify passcode",
                "parameters": [
                    {
                        "description": "Passcode and device info",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.VerifyPasscodeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.AuthResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/polizas/providers": {
            "get": {
                "description": "Returns the keys of all afianzadoras currently registered and available for validation",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "polizas"
                ],
                "summary": "List supported providers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.ProvidersResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/polizas/validate": {
            "post": {
                "description": "Scrapes the afianzadora website and returns the validation result. Results are cached for CACHE_TTL_HOURS. Use force_refresh=true to bypass cache.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "polizas"
                ],
                "summary": "Validate fianza policy",
                "parameters": [
                    {
                        "description": "Validation request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.ValidationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.ValidationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns service liveness. Does not check DB — use for load balancer probes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/validafianza-server_internal_models.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_handlers.AuthResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "internal_handlers.RegisterLoginRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "company_name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.VerifyPasscodeRequest": {
            "type": "object",
            "required": [
                "code",
                "fingerprint_data"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "maxLength": 8,
                    "minLength": 6
                },
                "device_name": {
                    "type": "string"
                },
                "fingerprint_data": {
                    "type": "string"
                }
            }
        },
        "validafianza-server_internal_models.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "provider not found: UNKNOWN"
                }
            }
        },
        "validafianza-server_internal_models.HealthResponse": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "example": "validafianza-api"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "validafianza-server_internal_models.ProvidersResponse": {
            "type": "object",
            "properties": {
                "providers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "MAPFRE",
                        "BERKLEY_MEXICO_FIANZAS",
                        "SOFIMEX"
                    ]
                }
            }
        },
        "validafianza-server_internal_models.ValidationRequest": {
            "type": "object",
            "properties": {
                "force_refresh": {
                    "description": "Skip cache and force a fresh scrape",
                    "type": "boolean",
                    "example": false
                },
                "lookup_key": {
                    "description": "Policy number / línea de validación",
                    "type": "string",
                    "example": "0032400003909000000491774"
                },
                "provider_key": {
                    "description": "Afianzadora key — must match a registered provider",
                    "type": "string",
                    "example": "MAPFRE"
                }
            }
        },
        "validafianza-server_internal_models.ValidationResponse": {
            "type": "object",
            "properties": {
                "cached_at": {
                    "description": "When the result was served from cache",
                    "type": "string"
                },
                "data": {
                    "description": "Provider-specific structured data",
                    "type": "object",
                    "additionalProperties": true
                },
                "html_extraido": {
                    "description": "Raw HTML fragments extracted from the provider page",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "mensaje": {
                    "description": "Human-readable result message",
                    "type": "string",
                    "example": "Póliza validada exitosamente en MAPFRE"
                },
                "no_valido": {
                    "description": "True when the policy could not be validated",
                    "type": "boolean",
                    "example": false
                },
                "scraped_at": {
                    "description": "When the scrape was performed",
                    "type": "string"
                },
                "valido": {
                    "description": "True when the policy is valid and active",
                    "type": "boolean",
                    "example": true
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and JWT token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}